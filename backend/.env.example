# ── Django ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins of the frontend (CORS) and, in production, CSRF trusted origins
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=

# ── Database (SQLite by default for development; PostgreSQL recommended in production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=wakara_db
# DB_USER=wakara_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── JWT ──────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Login protection ─────────────────────────────────────
LOGIN_THROTTLE_RATE=10/min
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Private documents & uploads ──────────────────────────
# Must be OUTSIDE any web-served directory.
# PRIVATE_MEDIA_ROOT=/var/lib/wakara/private_media
MAX_UPLOAD_SIZE_MB=10

# ── First administrator (used by `manage.py setup_initial_data`) ──
# Business role "Administrateur technique Wakara" — NOT a Django superuser.
WAKARA_ADMIN_USERNAME=
WAKARA_ADMIN_PASSWORD=
WAKARA_ADMIN_EMAIL=

# ── Demo data (development only, refused when DEBUG=False) ──
DEMO_USER_PASSWORD=

# ── Business hypotheses pending validation by the mairie ──
# (see docs/business-decisions.md)
DECLARATION_REQUIRED_FOR_TRANSMISSION=birth_date,child.gender,child.name,mother.name
ACTE_REQUIRED_FOR_SUBMISSION=acte.declaration_date,declarant.name
ACTE_AUTO_NUMBERING=False
STATS_SHOW_GENDER=True

# ── Production only ──────────────────────────────────────
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
